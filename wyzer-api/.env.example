# ──────────────────────────────────────────────────────────────
# wyzer-api — local development environment
# Copy to .env and fill in real values before running.
# NEVER commit .env to source control.
# ──────────────────────────────────────────────────────────────

# Application
NODE_ENV="development"
PORT=3001

# Database
# Local dev: use the docker-compose postgres (see docker-compose.yml)
# Production: use your Neon PostgreSQL connection string
DATABASE_URL="postgresql://wyzer:wyzer_secret@localhost:5432/wyzer_dev"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"

# JWT — RS256 asymmetric signing
# Generate: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Paste the full PEM content with literal \n line breaks
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Email (use Mailhog SMTP for local dev, Resend for staging/prod)
RESEND_API_KEY="re_..."
EMAIL_FROM="Wyzer <noreply@wyzer.dev>"
APP_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible)
# Endpoint: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="wyzer-reports-dev"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_URL="https://reports.wyzer.dev"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
