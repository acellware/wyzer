---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';

const PAINS = [
  {
    icon: 'layers',
    title: 'One question, five documents',
    body: 'NIST, GDPR, ISO 27001, PCI DSS and FDA each live in their own long PDF. Answering one question means searching all of them and stitching the pieces together.',
  },
  {
    icon: 'languages',
    title: 'Written for lawyers, not builders',
    body: 'The source text is dense and legalistic. Translating it into "what do I actually need to do" takes real compliance expertise.',
  },
  {
    icon: 'help',
    title: 'Hard to know what even applies',
    body: "Without a compliance background, it's unclear which frameworks touch a given cloud resource or industry topic in the first place.",
  },
];
---

<section id="why" class="py-[var(--section-gap)]">
  <div class="max-w-[1240px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-12">
    <!-- Left: header -->
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <SectionHeader
          index="01"
          kicker="the problem"
          title="The answer is buried in five different PDFs."
          intro="A simple question about one resource turns into an afternoon of reading dense, legal documents, one per framework."
        />
      </div>
    </div>

    <!-- Right: stacked pains -->
    <div class="lg:col-span-7 lg:pt-2">
      {PAINS.map((p, i) => (
        <div class:list={['flex gap-5 py-7', i > 0 && 'border-t']} style="border-color: var(--color-border-subtle)">
          <div class="w-9 h-9 rounded-md flex items-center justify-center shrink-0" style="background: var(--color-accent-soft)">
            <Icon name={p.icon} class="[color:var(--color-accent-ink)]" />
          </div>
          <div>
            <h3 class="text-[16px] font-semibold mb-2" style="color: var(--color-ink)">{p.title}</h3>
            <p class="text-[14.5px] leading-[1.65]" style="color: var(--color-body)">{p.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
