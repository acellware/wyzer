---
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';

const FRAMEWORKS = [
  { name: 'NIST', color: '#3B5B8C' },
  { name: 'SOC 2', color: '#2F855A' },
  { name: 'ISO 27001', color: '#2B6CB0' },
  { name: 'GDPR', color: '#5A67D8' },
  { name: 'HIPAA', color: '#319795' },
  { name: 'PCI DSS', color: '#B7791F' },
  { name: 'FDA', color: '#9B2C2C' },
];

const PROVIDERS = [
  { name: 'AWS', color: '#F5921E' },
  { name: 'Azure', color: '#2E7DD1' },
  { name: 'Google Cloud', color: '#4285F4' },
];

const INDUSTRIES = [
  { name: 'Fintech', icon: 'landmark' },
  { name: 'Healthcare', icon: 'activity' },
];
---

<section id="frameworks" class="py-[var(--section-gap)]">
  <div class="max-w-[1240px] mx-auto px-6">
    <SectionHeader
      index="03"
      kicker="frameworks"
      title="Every major framework. One plain-language view."
      intro="Seven of the most widely referenced frameworks, explained in everyday language, with more on the way."
      class="mb-14"
    />

    <!-- Coverage card -->
    <div class="rounded-2xl border p-6 sm:p-8" style="border-color: var(--color-border-subtle); background: var(--color-surface)">
      <!-- Frameworks -->
      <div class="flex items-center gap-2 mb-4">
        <span style="color: var(--color-accent-ink)"><Icon name="shield" size={14} /></span>
        <p class="font-mono text-[11px] uppercase tracking-widest" style="color: var(--color-muted)">Frameworks</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {FRAMEWORKS.map((f) => (
          <span
            class="inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 font-mono text-[11px] font-semibold uppercase tracking-wide"
            style={`background:${f.color}12; color: var(--color-ink); border:1px solid ${f.color}40;`}
          >
            <span class="h-1.5 w-1.5 rounded-full" style={`background:${f.color}`} aria-hidden="true"></span>
            {f.name}
          </span>
        ))}
      </div>

      <div class="my-7 h-px" style="background: var(--color-border-subtle)"></div>

      <!-- Providers + Industries + Free -->
      <div class="flex flex-col lg:flex-row lg:items-end gap-8 lg:gap-12">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-widest mb-3" style="color: var(--color-muted)">Cloud providers</p>
          <div class="flex flex-wrap gap-2">
            {PROVIDERS.map((p) => (
              <span class="inline-flex items-center gap-2 rounded-lg border px-3 py-1.5" style="border-color: var(--color-border-subtle); background: var(--color-page)">
                <span class="inline-flex" style={`color:${p.color}`}><Icon name="cloud" size={16} /></span>
                <span class="text-[13px] font-medium" style="color: var(--color-ink)">{p.name}</span>
              </span>
            ))}
          </div>
        </div>

        <div>
          <p class="font-mono text-[11px] uppercase tracking-widest mb-3" style="color: var(--color-muted)">Industries</p>
          <div class="flex flex-wrap gap-2">
            {INDUSTRIES.map((ind) => (
              <span class="inline-flex items-center gap-2 rounded-lg border px-3 py-1.5" style="border-color: var(--color-border-subtle); background: var(--color-page)">
                <span class="inline-flex" style="color: var(--color-accent-ink)"><Icon name={ind.icon} size={16} /></span>
                <span class="text-[13px] font-medium" style="color: var(--color-ink)">{ind.name}</span>
              </span>
            ))}
          </div>
        </div>

        <div class="lg:ml-auto">
          <span class="inline-flex items-center gap-2 rounded-lg px-3.5 py-2.5" style="background: var(--color-accent-soft)">
            <span style="color: var(--color-accent-ink)"><Icon name="gift" size={16} /></span>
            <span class="text-[13px] font-semibold" style="color: var(--color-accent-ink)">Free. No sign-up.</span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
