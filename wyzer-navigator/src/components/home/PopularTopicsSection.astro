---
import { getCollection } from 'astro:content';
import SectionHeader from '../SectionHeader.astro';

const order = [
  'object-storage-public-access',
  'encryption-at-rest',
  'data-in-transit-encryption',
  'iam-least-privilege',
  'mfa-enforcement',
];
const all = await getCollection('topics');
const topics = order
  .map((slug) => all.find((t) => t.slug === slug))
  .filter((t): t is (typeof all)[number] => Boolean(t));

const label = (fw: string) =>
  fw === 'pci-dss' ? 'PCI' : fw === 'iso27001' ? 'ISO' : fw.toUpperCase();
---

<section id="popular" class="py-[var(--section-gap)]">
  <div class="max-w-[1240px] mx-auto px-6">
    <SectionHeader
      index="05"
      kicker="popular"
      title="Start with a common topic."
      intro="A few of the questions people look up most. Each one shows what every relevant framework says."
      class="mb-12"
    />
    <div>
      {topics.map((t, i) => (
        <a
          href={`/topic/${t.slug}`}
          class:list={[
            'group flex items-start gap-5 sm:gap-8 py-6 -mx-4 px-4 rounded-lg transition-colors hover:[background-color:var(--color-surface)]',
            i > 0 && 'border-t',
          ]}
          style="border-color: var(--color-border-subtle)"
        >
          <span class="font-mono text-[12px] pt-1 tabular-nums" style="color: var(--color-muted)">0{i + 1}</span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2.5">
              <h3 class="text-[17px] font-semibold transition-colors group-hover:[color:var(--color-accent)]" style="color: var(--color-ink)">
                {t.data.name}
              </h3>
              <span class="transition-transform group-hover:translate-x-1" style="color: var(--color-accent)">→</span>
            </div>
            <p class="mt-1.5 text-[14px] leading-[1.6] max-w-[620px]" style="color: var(--color-body)">{t.data.summary}</p>
          </div>
          <div class="hidden md:flex flex-wrap gap-1.5 justify-end w-[200px] shrink-0 pt-1">
            {t.data.cards.slice(0, 5).map((c) => (
              <span class="font-mono text-[10px] px-1.5 py-0.5 rounded uppercase" style="color: var(--color-muted); border: 1px solid var(--color-border-subtle)">
                {label(c.framework)}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
