---
// A light, on-brand mock of the real Topic Page, the hero visual.
const cards = [
  { name: 'NIST', color: '#3B5B8C', text: 'Public read access to sensitive data stores is discouraged; access should be least-privilege.' },
  { name: 'ISO 27001', color: '#2B6CB0', text: 'Access to information must follow a defined access-control policy.' },
  { name: 'GDPR', color: '#5A67D8', text: 'Personal data must be protected with appropriate technical measures.' },
  { name: 'PCI DSS', color: '#B7791F', text: 'Storage holding cardholder data must not be openly reachable.' },
];
---

<div class="rounded-xl overflow-hidden border shadow-sm" style="background: var(--color-surface); border-color: var(--color-border)">
  <!-- Window chrome -->
  <div class="flex items-center gap-3 px-4 h-10 border-b" style="background: var(--color-raised); border-color: var(--color-border-subtle)">
    <div class="flex items-center gap-1.5">
      <span class="w-3 h-3 rounded-full" style="background: #e06c6c"></span>
      <span class="w-3 h-3 rounded-full" style="background: #e0b34c"></span>
      <span class="w-3 h-3 rounded-full" style="background: #5fb87a"></span>
    </div>
    <span class="flex-1 text-center font-mono text-[11px]" style="color: var(--color-muted)">
      navigator.wyzer.io/topic/s3-public-access
    </span>
    <span class="w-12"></span>
  </div>

  <!-- Body -->
  <div class="p-6" style="background: var(--color-page)">
    <p class="font-mono text-[11px] mb-3" style="color: var(--color-muted)">
      aws / storage / s3 / public&nbsp;access
    </p>
    <h3 class="text-[22px] font-semibold tracking-[-0.02em] mb-2" style="color: var(--color-ink)">
      S3 Public Access
    </h3>
    <p class="text-[13.5px] leading-[1.55] mb-5" style="color: var(--color-body)">
      Whether a storage bucket can be read by anyone on the internet. Most frameworks
      expect buckets with sensitive data to be private by default.
    </p>

    <p class="font-mono text-[10px] uppercase tracking-widest mb-3" style="color: var(--color-muted)">
      what each framework says
    </p>
    <div class="grid grid-cols-2 gap-3">
      {cards.map((c) => (
        <div class="rounded-lg border p-3" style="background: var(--color-surface); border-color: var(--color-border-subtle)">
          <span
            class="inline-flex items-center rounded-md px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wide"
            style={`background:${c.color}1f; color:${c.color}; border:1px solid ${c.color}40;`}
          >
            {c.name}
          </span>
          <p class="mt-2 text-[11.5px] leading-[1.5]" style="color: var(--color-body)">{c.text}</p>
          <p class="mt-2 font-mono text-[10px]" style="color: var(--color-accent-ink)">Read more →</p>
        </div>
      ))}
    </div>
  </div>
</div>
