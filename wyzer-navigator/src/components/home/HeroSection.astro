---
import TopicPreview from './TopicPreview.astro';

const FRAMEWORKS = ['NIST', 'SOC 2', 'ISO 27001', 'GDPR', 'HIPAA', 'PCI DSS', 'FDA'];
---

<section class="pb-[var(--section-gap)]" style="border-bottom: 1px solid var(--color-border-subtle)">
  <div class="max-w-[1240px] mx-auto px-6 pt-20 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    <!-- Left -->
    <div>
      <p class="font-mono text-[12px] mb-8" style="color: var(--color-muted)">
        plain-language compliance reference
      </p>
      <h1 class="text-display-1 balance mb-6" style="color: var(--color-ink)">
        What do the rules <span style="color: var(--color-accent)">actually</span> say?
      </h1>
      <p class="text-[18px] leading-[1.65] mb-10 max-w-[480px]" style="color: var(--color-body)">
        Look up any cloud resource or industry topic and see what NIST, SOC&nbsp;2,
        ISO&nbsp;27001, GDPR, HIPAA, PCI&nbsp;DSS, and FDA require, in plain English,
        in one view. Free. No sign-up.
      </p>
      <div class="flex flex-wrap gap-3 mb-4">
        <a
          href="/cloud"
          class="h-12 px-5 inline-flex items-center gap-2 text-[15px] font-medium rounded-[10px] text-white transition-colors hover:[background-color:var(--color-accent-ink)]"
          style="background: var(--color-accent)"
        >
          Browse by Cloud
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" /></svg>
        </a>
        <a
          href="/industry"
          class="h-12 px-5 inline-flex items-center text-[15px] rounded-[10px] border transition-colors hover:[background-color:var(--color-raised)] hover:[border-color:var(--color-ink)]"
          style="color: var(--color-ink); border-color: var(--color-border)"
        >
          Browse by Industry
        </a>
      </div>

      <a
        href="/search"
        class="group flex max-w-md items-center gap-2.5 rounded-[10px] border px-3.5 h-11 mb-12 transition-colors hover:[border-color:var(--color-border)]"
        style="border-color: var(--color-border-subtle); background: var(--color-surface)"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-muted)"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        <span class="text-[14px]" style="color: var(--color-muted)">Search topics, like “S3 public access”</span>
      </a>
      <p class="font-mono text-[11px] mb-2.5" style="color: var(--color-muted)">7 frameworks covered</p>
      <div class="flex flex-wrap gap-2">
        {FRAMEWORKS.map((f) => (
          <span
            class="font-mono text-[12px] px-2.5 py-1 rounded-md"
            style="color: var(--color-muted); border: 1px solid var(--color-border-subtle); background: var(--color-surface)"
          >
            {f}
          </span>
        ))}
      </div>
    </div>

    <!-- Right, Topic Page preview -->
    <div>
      <TopicPreview />
    </div>
  </div>
</section>
