---
interface Props {
  name: string;
  color: string;
  tier?: string;
}
const { name, color, tier } = Astro.props;
---

<span
  class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 font-mono text-2xs font-semibold uppercase tracking-wide"
  style={`background:${color}1f; color:${color}; border:1px solid ${color}40;`}
>
  {name}{tier && <span class="opacity-70">· {tier}</span>}
</span>
