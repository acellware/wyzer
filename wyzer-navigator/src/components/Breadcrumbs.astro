---
import type { Crumb } from '@/lib/content';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-2xs text-ink-muted">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {item.href ? (
          <a href={item.href} class="hover:text-brand">{item.label}</a>
        ) : (
          <span class="text-ink-secondary">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-ink-dim">/</span>}
      </li>
    ))}
  </ol>
</nav>
