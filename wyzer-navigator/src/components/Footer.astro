---
const cols = [
  {
    heading: 'Browse',
    links: [
      { label: 'By Cloud', href: '/cloud' },
      { label: 'By Industry', href: '/industry' },
    ],
  },
  {
    heading: 'Frameworks',
    links: [
      { label: 'NIST CSF', href: '/#frameworks' },
      { label: 'SOC 2', href: '/#frameworks' },
      { label: 'ISO 27001', href: '/#frameworks' },
      { label: 'GDPR', href: '/#frameworks' },
      { label: 'HIPAA', href: '/#frameworks' },
      { label: 'PCI DSS', href: '/#frameworks' },
      { label: 'FDA', href: '/#frameworks' },
    ],
  },
  {
    heading: 'Navigator',
    links: [
      { label: 'Why Navigator', href: '/#why' },
      { label: 'How it works', href: '/#how' },
      { label: 'Popular topics', href: '/#popular' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { label: 'Privacy', href: '#' },
      { label: 'Terms', href: '#' },
      { label: 'Cookie policy', href: '#' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="border-t" style="background-color: var(--color-surface); border-color: var(--color-border-subtle)">
  <!-- Final CTA -->
  <div class="max-w-[1240px] mx-auto px-6 py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-end">
      <div class="lg:col-span-8">
        <p class="font-mono text-[12px] mb-5" style="color: var(--color-muted)">start anywhere</p>
        <h2 class="text-display-2 balance" style="color: var(--color-ink)">
          Understand your compliance picture.
          <br />
          In plain English.
        </h2>
      </div>
      <div class="lg:col-span-4 flex flex-wrap gap-3 lg:justify-end">
        <a
          href="/cloud"
          class="h-12 px-5 inline-flex items-center text-[15px] font-medium rounded-[10px] text-white transition-colors hover:[background-color:var(--color-accent-ink)]"
          style="background-color: var(--color-accent)"
        >
          Browse by Cloud
        </a>
        <a
          href="/industry"
          class="h-12 px-5 inline-flex items-center text-[15px] rounded-[10px] border transition-colors hover:[background-color:var(--color-raised)] hover:[border-color:var(--color-ink)]"
          style="color: var(--color-ink); border-color: var(--color-border)"
        >
          By Industry
        </a>
      </div>
    </div>
  </div>

  <!-- Link grid -->
  <div class="border-t" style="border-color: var(--color-border-subtle)">
    <div class="max-w-[1240px] mx-auto px-6 py-14">
      <div class="grid grid-cols-2 md:grid-cols-5 gap-10">
        <div class="col-span-2 md:col-span-1">
          <a href="/" class="flex items-center gap-2 mb-3">
            <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none">
              <rect x="0.5" y="0.5" width="23" height="23" rx="6" fill="var(--color-accent)" />
              <path d="M6 17L9.5 7H11.5L14 13.2L16.5 7H18.5L22 17H19.8L17.5 10.8L15 17H13L10.5 10.8L8.2 17H6Z" fill="white" />
            </svg>
            <span class="text-[15px] font-semibold tracking-[-0.01em]" style="color: var(--color-ink)">wyzer</span>
            <span class="font-mono text-[11px]" style="color: var(--color-muted)">navigator</span>
          </a>
          <p class="text-[13px] leading-[1.55] max-w-[220px]" style="color: var(--color-muted)">
            A plain-language reference for what compliance frameworks say about your stack. Free.
          </p>
        </div>
        {cols.map((col) => (
          <div>
            <p class="font-mono text-[11px] mb-4" style="color: var(--color-muted)">{col.heading}</p>
            <ul class="space-y-2.5">
              {col.links.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class="text-[13.5px] transition-colors hover:[color:var(--color-ink)]"
                    style="color: var(--color-body)"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="mt-14 pt-6 border-t flex flex-col md:flex-row justify-between gap-3" style="border-color: var(--color-border-subtle)">
        <p class="font-mono text-[11px]" style="color: var(--color-muted)">
          © {year} Wyzer · Informational only, not legal advice
        </p>
        <p class="font-mono text-[11px]" style="color: var(--color-muted)">plain-language compliance</p>
      </div>
    </div>
  </div>
</footer>
