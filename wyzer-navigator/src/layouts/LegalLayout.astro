---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';

interface Props {
  title: string;
  updated: string;
  description?: string;
}
const { title, updated, description } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="max-w-[760px] mx-auto px-6 py-16">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: title }]} />
    <h1 class="text-display-3" style="color: var(--color-ink)">{title}</h1>
    <p class="mt-3 font-mono text-2xs uppercase tracking-wide" style="color: var(--color-muted)">
      Last updated {updated}
    </p>
    <div class="prose-legal mt-8">
      <slot />
    </div>
  </div>
</Layout>
