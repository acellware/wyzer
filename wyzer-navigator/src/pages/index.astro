---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Explorer from '@/components/Explorer.tsx';

const origin = (Astro.site?.toString() ?? 'https://wyzernavigator.acellhq.com/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Compliance Navigator',
  url: `${origin}/`,
  description:
    'A plain-language reference for what NIST, SOC 2, ISO 27001, GDPR, HIPAA, PCI DSS, and FDA say about cloud resources and industry topics.',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${origin}/search?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

// Build the node tree from the content collections (embedded, SSG-friendly).
const cloudCol = (await getCollection('cloud')).sort((a, b) => a.data.order - b.data.order);
const industryCol = (await getCollection('industry')).sort((a, b) => a.data.order - b.data.order);
const topicsCol = await getCollection('topics');
const topicMap = new Map<string, { slug: string; name: string; summary: string; frameworks: string[] }>(
  topicsCol.map((t) => [t.slug, { slug: t.slug, name: t.data.name, summary: t.data.summary, frameworks: t.data.cards.map((c) => c.framework) }]),
);

const cloudNodes = cloudCol.map((p) => ({
  id: p.id,
  label: p.data.providerName,
  kind: 'provider',
  children: p.data.categories.map((cat) => ({
    id: cat.slug,
    label: cat.name,
    kind: 'category',
    children: cat.resources.map((r) => ({
      id: r.slug,
      label: r.name,
      kind: 'resource',
      children: r.configurations.map((cfg) => ({
        id: cfg.slug,
        label: cfg.name,
        kind: 'config',
        topic: topicMap.get(cfg.topic) ?? null,
      })),
    })),
  })),
}));

const industryNodes = industryCol.map((i) => ({
  id: i.id,
  label: i.data.industryName,
  kind: 'industry',
  children: i.data.functions.map((fn) => ({
    id: fn.slug,
    label: fn.name,
    kind: 'function',
    children: fn.topics.map((tn) => ({
      id: tn.slug,
      label: tn.name,
      kind: 'topic',
      topic: topicMap.get(tn.topic) ?? null,
    })),
  })),
}));

const tree = [
  { id: 'cloud', label: 'By Cloud', sublabel: 'AWS · Azure · Google Cloud', kind: 'root', children: cloudNodes },
  { id: 'industry', label: 'By Industry', sublabel: 'Fintech · Healthcare', kind: 'root', children: industryNodes },
];

const slugs = topicsCol.map((t) => t.slug);
const FRAMEWORKS = ['NIST', 'SOC 2', 'ISO 27001', 'GDPR', 'HIPAA', 'PCI DSS', 'FDA'];
---

<Layout title="Compliance Navigator" jsonLd={jsonLd}>
  <section class="mx-auto max-w-[820px] px-6 pt-14 pb-10 text-center sm:pt-20">
    <p class="font-mono text-[12px] uppercase tracking-[0.2em]" style="color: var(--color-accent-ink)">
      plain-language compliance
    </p>
    <h1 class="mt-4 text-display-2 balance" style="color: var(--color-ink)">
      What do the rules <span style="color: var(--color-accent)">actually</span> say?
    </h1>
    <p class="mt-4 mx-auto max-w-[520px] text-[16px] leading-[1.6]" style="color: var(--color-body)">
      Follow the path. Each choice reveals the next, until you land on what every
      framework says.
    </p>

    <div class="mt-10">
      <Explorer client:load tree={tree} />
    </div>

    <!-- Search + surprise -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[13px]">
      <button
        data-search-trigger
        type="button"
        class="inline-flex items-center gap-1.5 transition-colors hover:[color:var(--color-ink)]"
        style="color: var(--color-muted)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        Search topics
        <kbd class="font-mono text-[11px] px-1.5 py-0.5 rounded border" style="border-color: var(--color-border-subtle)">⌘K</kbd>
      </button>
      <span aria-hidden="true" style="color: var(--color-border)">·</span>
      <button
        id="surprise"
        type="button"
        data-slugs={JSON.stringify(slugs)}
        class="inline-flex items-center gap-1 transition-colors hover:[color:var(--color-ink)]"
        style="color: var(--color-muted)"
      >
        Surprise me
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <!-- Framework strip -->
    <div class="mt-12">
      <p class="font-mono text-[11px] uppercase tracking-wide" style="color: var(--color-muted)">covers</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {FRAMEWORKS.map((f) => (
          <span class="font-mono text-[12px] px-2.5 py-1 rounded-md" style="color: var(--color-muted); border: 1px solid var(--color-border-subtle); background: var(--color-surface)">{f}</span>
        ))}
      </div>
    </div>
  </section>
</Layout>
