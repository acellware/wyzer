---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Icon from '@/components/Icon.astro';

const origin = (Astro.site?.toString() ?? 'https://wyzernavigator.acellhq.com/').replace(/\/$/, '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Compliance Navigator',
  url: `${origin}/`,
  description:
    'A plain-language reference for what NIST, SOC 2, ISO 27001, GDPR, HIPAA, PCI DSS, and FDA say about cloud resources and industry topics.',
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${origin}/search?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const topics = await getCollection('topics');
const slugs = topics.map((t) => t.slug);

const FRAMEWORKS = ['NIST', 'SOC 2', 'ISO 27001', 'GDPR', 'HIPAA', 'PCI DSS', 'FDA'];
---

<Layout title="Compliance Navigator" jsonLd={jsonLd}>
  <section class="mx-auto max-w-[880px] px-6 pt-16 pb-8 text-center sm:pt-24" data-reveal>
    <p class="font-mono text-[12px] uppercase tracking-[0.2em]" style="color: var(--color-accent-ink)">
      plain-language compliance
    </p>
    <h1 class="mt-5 text-display-1 balance" style="color: var(--color-ink)">
      What do the rules <span style="color: var(--color-accent)">actually</span> say?
    </h1>
    <p class="mt-5 mx-auto max-w-[560px] text-[18px] leading-[1.6]" style="color: var(--color-body)">
      Pick a starting point and we'll walk you through what every relevant framework
      says, in plain English, one screen at a time.
    </p>

    <!-- Two doors -->
    <div class="mt-12 grid gap-4 text-left sm:grid-cols-2">
      <a
        href="/cloud"
        class="nav-glow group flex flex-col rounded-2xl border p-6"
        style="border-color: var(--color-border-subtle); background: var(--color-surface)"
      >
        <div class="flex items-center justify-between">
          <span class="h-11 w-11 rounded-xl flex items-center justify-center" style="background: var(--color-accent-soft); color: var(--color-accent-ink)">
            <Icon name="cloud" size={22} />
          </span>
          <span class="transition-transform group-hover:translate-x-1" style="color: var(--color-muted)">→</span>
        </div>
        <h2 class="mt-4 text-[20px] font-semibold" style="color: var(--color-ink)">By Cloud</h2>
        <p class="mt-1 font-mono text-[12px]" style="color: var(--color-muted)">AWS · Azure · Google Cloud</p>
        <p class="mt-3 text-[13.5px] leading-[1.55]" style="color: var(--color-body)">
          Start from a provider, then drill into a service and configuration.
        </p>
      </a>

      <a
        href="/industry"
        class="nav-glow group flex flex-col rounded-2xl border p-6"
        style="border-color: var(--color-border-subtle); background: var(--color-surface)"
      >
        <div class="flex items-center justify-between">
          <span class="h-11 w-11 rounded-xl flex items-center justify-center" style="background: var(--color-accent-soft); color: var(--color-accent-ink)">
            <Icon name="landmark" size={22} />
          </span>
          <span class="transition-transform group-hover:translate-x-1" style="color: var(--color-muted)">→</span>
        </div>
        <h2 class="mt-4 text-[20px] font-semibold" style="color: var(--color-ink)">By Industry</h2>
        <p class="mt-1 font-mono text-[12px]" style="color: var(--color-muted)">Fintech · Healthcare</p>
        <p class="mt-3 text-[13.5px] leading-[1.55]" style="color: var(--color-body)">
          Start from your industry and pick a business function.
        </p>
      </a>
    </div>

    <!-- Search + surprise -->
    <div class="mt-6 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[13px]">
      <button
        data-search-trigger
        type="button"
        class="inline-flex items-center gap-1.5 transition-colors hover:[color:var(--color-ink)]"
        style="color: var(--color-muted)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        Search topics
        <kbd class="font-mono text-[11px] px-1.5 py-0.5 rounded border" style="border-color: var(--color-border-subtle)">⌘K</kbd>
      </button>
      <span aria-hidden="true" style="color: var(--color-border)">·</span>
      <button
        id="surprise"
        type="button"
        data-slugs={JSON.stringify(slugs)}
        class="inline-flex items-center gap-1 transition-colors hover:[color:var(--color-ink)]"
        style="color: var(--color-muted)"
      >
        Surprise me
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <!-- Framework strip -->
    <div class="mt-14">
      <p class="font-mono text-[11px] uppercase tracking-wide" style="color: var(--color-muted)">covers</p>
      <div class="mt-3 flex flex-wrap justify-center gap-2">
        {FRAMEWORKS.map((f) => (
          <span class="font-mono text-[12px] px-2.5 py-1 rounded-md" style="color: var(--color-muted); border: 1px solid var(--color-border-subtle); background: var(--color-surface)">{f}</span>
        ))}
      </div>
    </div>
  </section>
</Layout>
