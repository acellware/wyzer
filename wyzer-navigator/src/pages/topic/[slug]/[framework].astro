---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getFrameworkMap } from '@/lib/content';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.flatMap((topic) =>
    topic.data.cards.map((card) => ({
      params: { slug: topic.slug, framework: card.framework },
      props: { topic, card, framework: card.framework, topics },
    })),
  );
}

const { topic, card, framework, topics } = Astro.props;
const fwMap = await getFrameworkMap();
const fw = fwMap.get(framework);
if (!fw) {
  throw new Error(`[content] Detail page references unknown framework "${framework}".`);
}
const color = fw.data.badgeColor;

const paragraphs = (card.detail ?? '')
  .split('\n')
  .map((p) => p.trim())
  .filter(Boolean);
const citations = card.citations ?? [];

// Every framework that covers this topic — the "lens switcher".
const lenses = topic.data.cards.map((c) => ({
  slug: c.framework,
  fw: fwMap.get(c.framework)!,
  active: c.framework === framework,
}));

// Other topics under this same framework.
const similar = topics
  .filter((t) => t.slug !== topic.slug && t.data.cards.some((c) => c.framework === framework))
  .slice(0, 6)
  .map((t) => ({ t, card: t.data.cards.find((c) => c.framework === framework)! }));

const title = `${fw.data.shortName}: ${topic.data.name}`;
---

<Layout title={title} description={card.plain}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: topic.data.name, href: `/topic/${topic.slug}` },
        { label: fw.data.shortName },
      ]}
    />

    <!-- Header -->
    <div class="h-1 w-10 rounded-full" style={`background:${color}`}></div>
    <div class="mt-6 flex flex-wrap items-center gap-2.5">
      <span
        class="inline-flex items-center gap-2 rounded-lg px-3 py-1.5 text-sm font-semibold"
        style={`background:${color}14; color:${color}; border:1px solid ${color}33;`}
      >
        <span class="h-2 w-2 rounded-full" style={`background:${color}`}></span>
        {fw.data.name}
      </span>
      {fw.data.tier && <span class="font-mono text-2xs uppercase tracking-wide text-ink-dim">{fw.data.tier}</span>}
    </div>

    <h1 class="mt-5 text-3xl font-semibold tracking-tight text-ink-primary sm:text-[40px] sm:leading-[1.05]">
      {topic.data.name}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-ink-secondary">{card.plain}</p>

    <!-- Framework switcher -->
    <div class="mt-7 flex flex-wrap items-center gap-2 border-t border-line-subtle pt-6">
      <span class="mr-1 font-mono text-2xs uppercase tracking-wide text-ink-dim">across frameworks</span>
      {lenses.map((l) =>
        l.active ? (
          <span
            class="inline-flex items-center rounded-md px-2.5 py-1 text-xs font-semibold"
            style={`background:${l.fw.data.badgeColor}1f; color:${l.fw.data.badgeColor}; border:1px solid ${l.fw.data.badgeColor}55;`}
          >
            {l.fw.data.shortName}
          </span>
        ) : (
          <a
            href={`/topic/${topic.slug}/${l.slug}`}
            class="inline-flex items-center rounded-md border border-line-subtle px-2.5 py-1 text-xs font-medium text-ink-muted transition-colors hover:border-line hover:bg-surface hover:text-ink-primary"
          >
            {l.fw.data.shortName}
          </a>
        ),
      )}
    </div>

    <!-- In depth -->
    {paragraphs.length > 0 && (
      <section class="mt-10">
        <h2 class="font-mono text-2xs uppercase tracking-wide text-ink-dim">In depth</h2>
        <div class="mt-4 space-y-4 text-[16px] leading-[1.75] text-ink-secondary">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}

    <!-- Sources -->
    {citations.length > 0 && (
      <section class="mt-10">
        <h2 class="font-mono text-2xs uppercase tracking-wide text-ink-dim">
          {citations.length === 1 ? 'Source' : 'Sources'}
        </h2>
        <ul class="mt-4 space-y-3">
          {citations.map((c) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-0.5 shrink-0" style={`color:${color}`}>
                {c.url ? (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6" /><path d="M10 14 21 3" /><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
                ) : (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h.01" /></svg>
                )}
              </span>
              {c.url ? (
                <a href={c.url} target="_blank" rel="noopener" class="text-sm leading-6 text-ink-secondary underline-offset-2 hover:text-brand hover:underline">
                  {c.label}
                </a>
              ) : (
                <span class="text-sm leading-6 text-ink-secondary">{c.label}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="mt-10 text-2xs leading-5 text-ink-dim">
      Informational only, not legal advice. Always confirm against the official framework text.
    </p>

    <!-- Back to topic -->
    <div class="mt-8 border-t border-line-subtle pt-6">
      <a href={`/topic/${topic.slug}`} class="group inline-flex items-center gap-1.5 text-sm font-medium text-brand">
        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">←</span>
        <span class="group-hover:underline">See all frameworks for {topic.data.name}</span>
      </a>
    </div>

    <!-- More topics under this framework -->
    {similar.length > 0 && (
      <section class="mt-12">
        <h2 class="font-mono text-2xs uppercase tracking-wide text-ink-dim">More {fw.data.shortName} topics</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          {similar.map(({ t, card: sc }) => (
            <a
              href={`/topic/${t.slug}/${framework}`}
              class="group rounded-xl border border-line-subtle bg-surface p-4 transition-colors hover:border-line"
            >
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-sm font-semibold text-ink-primary group-hover:text-brand">{t.data.name}</h3>
                <span aria-hidden="true" class="text-ink-muted transition-transform group-hover:translate-x-0.5 group-hover:text-brand">→</span>
              </div>
              <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-ink-muted">{sc.plain}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>
