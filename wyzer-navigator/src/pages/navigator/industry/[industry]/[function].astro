---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import NavCard from '@/components/NavCard.astro';
import { getTopicMap, requireTopic } from '@/lib/content';

export async function getStaticPaths() {
  const industries = await getCollection('industry');
  return industries.flatMap((industry) =>
    industry.data.functions.map((fn) => ({
      params: { industry: industry.id, function: fn.slug },
      props: { industry, fn },
    })),
  );
}

const { industry, fn } = Astro.props;
const topicMap = await getTopicMap();

const topics = fn.topics.map((node) => {
  const topic = requireTopic(
    topicMap,
    node.topic,
    `industry/${industry.id}.yaml → ${fn.slug} → ${node.slug}`,
  );
  return { node, topic };
});
---

<Layout
  title={`${fn.name} · ${industry.data.industryName}`}
  description={`Compliance topics for ${fn.name} in ${industry.data.industryName}.`}
>
  <div class="mx-auto max-w-content px-4 py-10">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/navigator' },
        { label: 'Industry', href: '/navigator/industry' },
        { label: industry.data.industryName, href: `/navigator/industry/${industry.id}` },
        { label: fn.name },
      ]}
    />
    <h1 class="text-3xl font-semibold tracking-tight text-ink-primary">
      {fn.name}
      <span class="text-ink-muted"> · {industry.data.industryName}</span>
    </h1>
    {fn.blurb && <p class="mt-3 max-w-2xl text-ink-muted">{fn.blurb}</p>}

    <div class="mt-8 grid gap-4 sm:grid-cols-2" data-reveal>
      {topics.map(({ node, topic }) => (
        <NavCard
          href={`/navigator/topic/${topic.slug}`}
          title={node.name}
          blurb={topic.data.summary}
          note={topic.data.type === 'industry-only' ? 'Industry-only topic' : undefined}
        />
      ))}
    </div>
  </div>
</Layout>
