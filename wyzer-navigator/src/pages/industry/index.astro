---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import NavCard from '@/components/NavCard.astro';

const industries = (await getCollection('industry')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Browse by Industry" description="Pick an industry to see the compliance topics that matter to it.">
  <div class="mx-auto max-w-content px-4 py-10">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Industry' }]} />
    <h1 class="text-3xl font-semibold tracking-tight text-ink-primary">Browse by Industry</h1>
    <p class="mt-3 max-w-2xl text-ink-muted">
      Start with your industry, then pick a business function to see the topics that
      matter most, including ones that do not map to a specific cloud service.
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {industries.map((i) => (
        <NavCard
          href={`/industry/${i.id}`}
          title={i.data.industryName}
          blurb={i.data.blurb}
          meta={`${i.data.functions.length} functions`}
        />
      ))}
    </div>
  </div>
</Layout>
