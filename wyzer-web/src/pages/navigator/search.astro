---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
---

<Layout
  title="Search"
  description="Search plain-language compliance topics across NIST, SOC 2, ISO 27001, GDPR, HIPAA, PCI DSS, and FDA."
>
  <section class="max-w-[860px] mx-auto px-6 py-16">
    <Breadcrumbs items={[{ label: 'Home', href: '/navigator' }, { label: 'Search' }]} />
    <h1 class="text-display-3" style="color: var(--color-ink)">Search topics</h1>
    <p class="mt-3 text-[16px]" style="color: var(--color-muted)">
      Find a cloud resource or industry topic and see what every framework says.
    </p>

    <div id="search" class="mt-8"></div>

    <p class="mt-8 font-mono text-[11px]" style="color: var(--color-muted)">
      Not sure where to start? Browse
      <a href="/navigator/cloud" style="color: var(--color-accent-ink)" class="underline">by cloud</a>
      or
      <a href="/navigator/industry" style="color: var(--color-accent-ink)" class="underline">by industry</a>.
    </p>
  </section>
</Layout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI === 'undefined') {
      document.getElementById('search').innerHTML =
        '<p style="color: var(--color-muted); font-size: 14px;">Search is available on the built site. Run a production build to generate the index.</p>';
      return;
    }
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      pageSize: 8,
    });
    const params = new URLSearchParams(window.location.search);
    const q = params.get('q');
    if (q) {
      const input = document.querySelector('#search input');
      if (input) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  });
</script>
