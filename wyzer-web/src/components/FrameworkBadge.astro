---
interface Props {
  name: string;
  color: string;
  tier?: string;
}
const { name, color, tier } = Astro.props;
---

<span
  class="inline-flex items-center gap-1.5 rounded-md px-2 py-0.5 font-mono text-2xs font-semibold uppercase tracking-wide"
  style={`background:${color}12; color: var(--color-ink); border:1px solid ${color}40;`}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background:${color}`} aria-hidden="true"></span>
  {name}{tier && <span class="font-normal text-ink-muted"> · {tier}</span>}
</span>
