---
import type { Crumb } from '@/lib/content';

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {item.href ? (
          <a
            href={item.href}
            class="text-ink-muted underline-offset-2 transition-colors hover:text-brand hover:underline"
          >
            {item.label}
          </a>
        ) : (
          <span class="font-medium text-ink-secondary" aria-current="page">{item.label}</span>
        )}
        {i < items.length - 1 && <span aria-hidden="true" class="text-ink-dim">/</span>}
      </li>
    ))}
  </ol>
</nav>
