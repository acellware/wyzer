---
// Global ⌘K search modal, adapted for Astro View Transitions.
// The modal + its lazily-loaded Pagefind UI persist across navigations, and all
// wiring is one-time + delegated so it survives DOM swaps.
---

<div
  id="search-modal"
  class="hidden fixed inset-0 z-[70]"
  role="dialog"
  aria-modal="true"
  aria-label="Search topics"
  transition:persist
>
  <div class="absolute inset-0" style="background: rgba(20,16,12,0.45)" data-search-close></div>
  <div
    class="relative mx-auto mt-[12vh] w-[92%] max-w-[620px] rounded-xl border overflow-hidden"
    style="background: var(--color-surface); border-color: var(--color-border); box-shadow: 0 24px 60px rgba(0,0,0,0.25)"
  >
    <div class="p-3">
      <div id="search-modal-inner"></div>
    </div>
    <div
      class="flex items-center justify-between px-4 py-2 border-t font-mono text-[11px]"
      style="border-color: var(--color-border-subtle); color: var(--color-muted)"
    >
      <span>search topics</span>
      <span>esc to close</span>
    </div>
  </div>
</div>

<script>
  (() => {
    if ((window as any).__navSearch) return;
    (window as any).__navSearch = true;

    let loaded = false;
    let initing = false;

    const modal = () => document.getElementById('search-modal');

    const loadPagefind = (): Promise<boolean> =>
      new Promise((resolve) => {
        if ((window as any).PagefindUI) return resolve(true);
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = '/pagefind/pagefind-ui.css';
        document.head.appendChild(css);
        const s = document.createElement('script');
        s.src = '/pagefind/pagefind-ui.js';
        s.onload = () => resolve(true);
        s.onerror = () => resolve(false);
        document.head.appendChild(s);
      });

    const open = async () => {
      const m = modal();
      if (!m) return;
      m.classList.remove('hidden');
      document.documentElement.style.overflow = 'hidden';
      if (!loaded && !initing) {
        initing = true;
        const ok = await loadPagefind();
        const inner = document.getElementById('search-modal-inner');
        if (ok && (window as any).PagefindUI) {
          new (window as any).PagefindUI({ element: '#search-modal-inner', showSubResults: true, showImages: false, pageSize: 6 });
          loaded = true;
        } else if (inner) {
          inner.innerHTML =
            '<p style="padding:12px;color:var(--color-muted);font-size:14px">Search is available on the built site. Run a production build to generate the index.</p>';
        }
        initing = false;
      }
      const input = m.querySelector('input');
      if (input) setTimeout(() => (input as HTMLInputElement).focus(), 40);
    };

    const close = () => {
      const m = modal();
      if (m) m.classList.add('hidden');
      document.documentElement.style.overflow = '';
    };

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      } else if (e.key === 'Escape') {
        const m = modal();
        if (m && !m.classList.contains('hidden')) close();
      }
    });

    document.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t || !t.closest) return;
      if (t.closest('[data-search-trigger]')) {
        e.preventDefault();
        open();
      } else if (t.closest('[data-search-close]')) {
        close();
      }
    });
  })();
</script>
