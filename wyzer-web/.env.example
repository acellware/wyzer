# Public origin is set via astro.config (`site: https://wyzer.acellhq.com`).

# Backend API base URL for the waitlist form (NestJS `wyzer-api`).
# Defaults to http://localhost:3001/api/v1 in dev. Must be PUBLIC_ (client-side).
PUBLIC_API_URL=http://localhost:3001/api/v1

# Google Analytics 4 measurement ID. Consent-gated; defaults to the shared
# property if unset. Set to your property for production.
PUBLIC_GA_ID=G-QQKWMXNVSH

# Set to "true" to log analytics events to the console (debugging).
PUBLIC_ANALYTICS_DEBUG=
