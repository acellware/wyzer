# Backend API base URL (axios). Defaults to http://localhost:3001/api/v1 in dev.
VITE_API_URL=http://localhost:3001/api/v1

# Canonical production origin, used for SEO canonical + og:url. No trailing slash.
VITE_SITE_URL=https://wyzer.acellhq.com

# The educational companion product (Compliance Navigator), linked from the nav/footer.
VITE_NAVIGATOR_URL=https://wyzernavigator.acellhq.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Optional: analytics and the cookie consent banner only activate when this is set.
# Use a property dedicated to this product, not the Navigator's.
VITE_GA_ID=

# Set to "true" to log analytics events to the console (debugging).
VITE_ANALYTICS_DEBUG=
